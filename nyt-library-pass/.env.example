# Copy this file to `.env` and fill it in. `.env` is git-ignored — never commit it.

# Step 1: your library's page that issues the NYT access code/pass.
# Homewood Public Library (JCLC). Codes last 24 hours; card must be current with < $5 in fines.
LIBRARY_PASS_URL=https://www.jclc.org/c/auth/ny/nyt_homewood.aspx

# Step 2: library card number (and PIN only if your library asks for one).
LIBRARY_CARD_NUMBER=
LIBRARY_PIN=

# Optional
# NYT_FULL_AUTO=false        # true = also log in + redeem on NYT in the automated browser.
#                            # NYT usually blocks that as a robot, so leave it off.
# NYT_EMAIL=                 # only used when NYT_FULL_AUTO=true
# NYT_PASSWORD=              # only used when NYT_FULL_AUTO=true
# STEP_TIMEOUT_MS=45000
# PROFILE_DIR=.browser-profile   # browser profile reused between runs
# SELECTORS_FILE=selectors.json  # site-specific selector overrides, see selectors.example.json
